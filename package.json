{
  "name": "vscode-tools",
  "displayName": "VS Code Tools",
  "description": "Shows remaining Codex usage limits in the VS Code status bar.",
  "version": "0.0.1",
  "publisher": "local",
  "engines": {
    "vscode": "^1.74.0"
  },
  "main": "./extension.js",
  "activationEvents": ["onStartupFinished"],
  "categories": ["Other"],
  "contributes": {
    "configuration": {
      "title": "VS Code Tools",
      "properties": {
        "vscodeTools.refreshIntervalSeconds": {
          "type": "number",
          "default": 60,
          "minimum": 1,
          "description": "Seconds between Codex usage limit refreshes."
        }
      }
    }
  },
  "scripts": {
    "test": "node test.js",
    "package": "vsce package --out vscode-tools.vsix --allow-missing-repository --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "^3.6.0"
  }
}
